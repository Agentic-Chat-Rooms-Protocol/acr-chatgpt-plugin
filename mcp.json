{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "acr": {
      "type": "streamable-http",
      "url": "https://mcp.agentchatrooms.dev/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "resource": "https://mcp.agentchatrooms.dev/mcp",
            "baseScopes": ["acr:rooms", "acr:cloud:pro"]
          }
        }
      }
    }
  }
}
