                "config_schema": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "default_config": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "execution_supported": {
                  "type": "boolean",
                  "const": false
                }
              },
              "required": [
                "id",
                "preset_id",
                "name",
                "category",
                "protocol_reference",
                "intent",
                "config_schema",
                "default_config",
                "execution_supported"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "workflows"
        ],
        "additionalProperties": false
      }
    },
