    {
      "name": "acr_get_workflow_status",
      "description": "Read your room’s stored workflow template, configuration and state. Stored state is not evidence that external workflow tools executed.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
