{
  "tools": [
    {
      "name": "acr_create_room",
      "description": "Create your own ACR Cloud room and bootstrap one of 18 canonical workflow templates. All Cloud rooms remain owner-scoped; is_private records visibility intent, not signed-DID admission. Does not execute workflow actions or return credentials.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "is_private": {
            "default": false,
            "type": "boolean"
          },
          "workflow_type": {
            "default": "bft-consensus-deliberation",
            "type": "string",
            "enum": [
              "postgres-split-brain",
              "preset-postgres-split-brain",
              "egress-token-anomaly",
              "preset-egress-anomaly",
              "ingress-oom-autoscaling",
              "preset-ingress-oom",
              "canary-deployment-rollback",
              "preset-canary-rollback",
              "code-review-tla-verification",
              "preset-code-review-tla",
              "saif-compliance-audit",
              "preset-saif-audit",
              "bft-consensus-deliberation",
              "preset-bft-deliberation",
              "twinseal-passkey-approval",
              "preset-twinseal-consent",
              "durable-wal-recovery",
              "preset-durable-wal-recovery",
              "context-compaction-pruning",
              "preset-context-compaction",
              "byzantine-fault-slashing",
              "preset-byzantine-slashing",
              "identity-key-rotation",
              "preset-identity-rotation",
              "micro-sandbox-isolation",
              "preset-micro-sandbox",
              "cross-model-agentflex-synthesis",
              "preset-agentflex-synthesis",
              "declarative-step-playbook",
              "preset-declarative-playbook",
              "postguard-injection-defense",
              "preset-postguard-firewall",
              "dynamic-dag-topology",
              "preset-dynamic-dag-topology",
              "transitive-trust-federation",
              "preset-trust-federation"
            ]
          },
          "workflow_config": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "drainGraceSec": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 60,
                    "description": "Time allocated to finish in-flight read queries before detaching follower replica."
                  },
                  "failoverTarget": {
                    "type": "string",
                    "enum": [
                      "read-replica-01",
                      "read-replica-02",
                      "db-standby-sync"
                    ],
                    "description": "Target secondary replica to receive read traffic redirect."
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "quarantineNamespace": {
                    "type": "string",
                    "maxLength": 2000,
                    "description": "Cluster namespace where compromised pod is executing."
                  },
                  "cascadeTokenRevocation": {
                    "type": "boolean",
                    "description": "Whether to invalidate all downstream API tokens minted by this token."
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "targetReplicas": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 50,
                    "description": "Horizontal pod scale target for load rebalancing."
                  },
                  "memoryLimit": {
                    "type": "string",
                    "maxLength": 2000,
                    "description": "Memory ceiling string per pod container resource spec."
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "targetReleaseVersion": {
                    "type": "string",
                    "maxLength": 2000,
                    "description": "Known stable image tag or semantic version for rollback."
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "tlaWorkers": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 32,
                    "description": "Number of parallel threads for TLC state space exploration."
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "complianceFramework": {
                    "type": "string",
                    "enum": [
                      "SAIF-Core-v2",
                      "SOC2-Type-II",
                      "ISO-27001-AI",
                      "NIST-AI-RMF"
                    ],
                    "description": "Regulatory compliance framework for emitted audit proofs."
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "quorumThreshold": {
                    "type": "number",
                    "minimum": 0.51,
                    "maximum": 1,
                    "description": "Supermajority fraction required to pass proposal."
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "challengeTtlSec": {
                    "type": "number",
                    "minimum": 30,
                    "maximum": 1800,
                    "description": "Time window during which human commanders must complete passkey gesture."
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "reconcileTimeoutMs": {
                    "type": "number",
                    "minimum": 500,
                    "maximum": 30000,
                    "description": "Maximum latency wait for upstream provider response before declaring OUTCOME_UNKNOWN."
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "retainedTurnCount": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 20,
                    "description": "Number of active recent events to preserve verbatim after compaction."
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "slashPenaltyRatio": {
                    "type": "number",
                    "minimum": 0.05,
                    "maximum": 1,
                    "description": "Proportion of Wilson confidence interval to deduct upon proven Byzantine infraction."
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "cryptographicCurve": {
                    "type": "string",
                    "enum": [
                      "Ed25519",
                      "Secp256k1",
                      "P-256"
                    ],
                    "description": "Elliptic curve algorithm for new key generation."
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "autoPurgeMinutes": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 60,
                    "description": "Hard TTL before micro-sandbox container is forcefully destroyed."
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "critiqueRounds": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5,
                    "description": "Iterations of dialectical peer critique before synthesizing final plan."
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "stopOnFirstError": {
                    "type": "boolean",
                    "description": "Halt the entire playbook sequence immediately if any step returns non-zero error."
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "sensitivityLevel": {
                    "type": "string",
                    "enum": [
                      "permissive",
                      "balanced",
                      "strict",
                      "paranoid"
                    ],
                    "description": "Anomaly score threshold for dropping suspect prompt turns."
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "maxParallelWorkers": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 16,
                    "description": "Maximum parallel branch concurrency limit."
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "maxBfsDepth": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 8,
                    "description": "Maximum depth for transitive trust BFS path evaluation (RFC-0017 default 3, max 8)."
                  },
                  "requireDoubleSigning": {
                    "type": "boolean",
                    "description": "Require both old and new keys to sign rotation links."
                  }
                },
                "additionalProperties": false
              }
            ],
            "description": "Partial configuration overrides. The server validates against the selected workflow; inspect acr_get_workflow for its exact schema."
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false,
        "idempotentHint": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "created": {
            "type": "boolean",
            "const": true
          },
          "room_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "is_private": {
            "type": "boolean"
          },
          "access": {
            "type": "string",
            "const": "owner"
          },
          "workflow_type": {
            "type": "string"
          },
          "workflow_config": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "execution_supported": {
            "type": "boolean",
            "const": false
          }
        },
        "required": [
          "created",
          "room_id",
          "name",
          "is_private",
          "access",
          "workflow_type",
          "workflow_config",
          "execution_supported"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "acr_list_workflows",
      "description": "List the 18 canonical ACR workflow templates, preset IDs, configuration schemas and defaults. Templates describe intended integrations; execution is not supported by this Cloud bridge.",
      "inputSchema": {
        "type": "object",
